# App
PORT=8000
SECRET_KEY=shared_dev_jwt_secret_key_12345

# Database 
DATABASE_URL=postgresql+psycopg://postgres:Password@localhost:5432/DatabaseName
REDIS_URL=redis://localhost:6379

# Frontend URL (required by config.py's Settings — team added this for CORS/reference)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Satellite / NDVI (our feature)
COPERNICUS_CLIENT_ID="ID"
COPERNICUS_CLIENT_SECRET="secret key"
USE_LIVE_SATELLITE=true

GEMINI_API_KEY=placeholder-not-real


# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_random_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
